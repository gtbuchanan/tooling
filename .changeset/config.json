{
  "$schema": "https://unpkg.com/@changesets/config@4/schema.json",
  "access": "public",
  "baseBranch": "main",
  "changedFilePatterns": [
    "**",
    "!e2e/**",
    "!eslint.config.ts",
    "!jactionlint.yaml",
    "!renovate.json",
    "!test/**",
    "!vitest.config*.ts",
    "!workflows/pr.yml",
    "!workflows/release.yml"
  ],
  "changelog": "@changesets/cli/changelog",
  "commit": false,
  "fixed": [],
  "format": false,
  "ignore": [
    "@gtbuchanan/test-utils"
  ],
  "linked": [],
  "privatePackages": {
    "tag": false,
    "version": true
  },
  "updateInternalDependencies": "patch"
}
