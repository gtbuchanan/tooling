#!/data/data/com.termux/files/usr/bin/bash
# pnpm wrapper for Termux/Android. The literal absolute-path shebang
# bypasses Termux's missing /usr/bin/env, which the kernel would
# otherwise dereference when glibc-built binaries (e.g. turbo) execve
# this script — Termux's Bionic LD_PRELOAD shim only intercepts libc
# execve calls, not the syscall path used by glibc binaries.
#
# Honors $PREFIX (Termux's standard env var) so non-default install
# locations still work; falls back to the shipped Termux paths.
#
# pnpm 11 and later ship a native binary behind `bin/pnpm.mjs`, which
# finds the installed binary and runs it; pnpm 10 and earlier run from
# `bin/pnpm.cjs`. The package's own `pnpm` bin is no target for either:
# it is a shebang-less placeholder until pnpm's install script replaces
# it, and a glibc execvp retries that under /bin/sh, which Termux lacks.
prefix="${PREFIX:-/data/data/com.termux/files/usr}"
pnpm_dir="${prefix}/lib/node_modules/pnpm"
entry="${pnpm_dir}/bin/pnpm.mjs"
[ -f "${entry}" ] || entry="${pnpm_dir}/bin/pnpm.cjs"
exec "${prefix}/bin/node" "${entry}" "$@"
