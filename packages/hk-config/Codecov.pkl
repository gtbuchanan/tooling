/// Validates Codecov config.
module gtbuchanan.hk.Codecov

import "HkPackage.pkl"

// One request per file, so a repository with config in two of Codecov's
// locations has both validated. The endpoint answers 200 for a valid document
// and 400 with the complaint in the body, and `--fail-with-body` turns the 400
// into a failure that still says why. On success it echoes the whole parsed
// config, so the body is printed only on failure: POSIX captures it in a
// variable, and cmd.exe, which can't, routes it through a temp file.
local codecovValidatePosix = """
  for f in {{files}}; do
    if ! out=$(curl -sS --fail-with-body --data-binary "@$f" https://codecov.io/validate); then
      echo "$out" >&2
      exit 1
    fi
  done
  """

local codecovValidateWindows = """
  for %f in ({{files}}) do @curl -sS --fail-with-body -o "%TEMP%\\hk-codecov-validate.json" --data-binary "@%f" https://codecov.io/validate || (type "%TEMP%\\hk-codecov-validate.json" 1>&2 & exit /b 1)
  """

/// Validates Codecov config against Codecov's own validator, in every location
/// Codecov reads it from. The validator checks the schema rather than the
/// meaning, which still catches the failure worth catching: Codecov ignores a
/// key it doesn't recognise, so a misspelling silently disables a section.
///
/// Runs at push time rather than commit time, since it calls Codecov — see
/// `Defaults.pushSteps`.
///
/// Needs `curl` 7.76 or later on PATH (for `--fail-with-body`), a system tool:
/// mise's registry has no curl, and curl publishes no release binaries for the
/// `ubi` or `aqua` backends to fetch.
codecovConfig: HkPackage.Step = new {
  glob = List(
    ".codecov.yml",
    ".github/.codecov.yml",
    ".github/codecov.yml",
    "codecov.yml",
    "dev/.codecov.yml",
    "dev/codecov.yml",
  )
  check = new HkPackage.Script {
    windows = codecovValidateWindows
    linux = codecovValidatePosix
    macos = codecovValidatePosix
    other = codecovValidatePosix
  }
}
