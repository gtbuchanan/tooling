/// Shared hk building blocks for @gtbuchanan/tooling consumers. The fast path:
/// spread `...recommended` into a step mapping, add your repo-specific steps
/// (e.g. eslint), and build the hook trio with `hooksFor(steps)`. The
/// individual steps (`fileHygiene`, `jactionlint`, `shell`, ...) and the
/// `defaultExclude` primitive stay exported for granular composition.
@ModuleInfo { minPklVersion = "0.27.2" }
module gtbuchanan.hk.Defaults

import "package://github.com/jdx/hk/releases/download/v2.11.0/hk@2.11.0#/Config.pkl"
import "package://github.com/jdx/hk/releases/download/v2.11.0/hk@2.11.0#/Builtins.pkl"

/// Machine-generated lockfiles — exempt from the file-hygiene fixers.
lockfileExclude: Regex = Regex(#"[-.]lock(\.|$)"#)

/// Vendored third-party sources under a root `vendor/` — not ours to fix.
vendorExclude: Regex = Regex(#"^vendor/"#)

/// Default exclude for file-hygiene (and consumer tool) steps: lockfiles plus
/// vendored sources. Wire onto your own steps with `exclude = Defaults.defaultExclude`.
defaultExclude: Regex = Regex("\(lockfileExclude.pattern)|\(vendorExclude.pattern)")

/// jactionlint's rule profiles, narrowest first.
typealias JactionlintProfile = "correctness"|"default"|"pedantic"

// Insert `--profile <profile>` after the `jactionlint` word of a builtin
// command, wherever it sits: `check_diff` runs it behind `hk util sarif-diff`.
// Amending the builtin's spec rather than building a new one keeps its argv
// and declared `effect` tracking upstream.
local function withProfile(spec: Config.CommandSpec, profile: JactionlintProfile): Config.CommandSpec = (spec) {
  command = new Config.Command {
    argv = (spec.command as Config.Command).argv.flatMap((arg) ->
      if (arg == "jactionlint") List(arg, "--profile", profile) else List(arg)
    )
  }
}

/// jactionlint (a maintained actionlint fork) over workflows, composite
/// actions and Dependabot config, limited to `profile`. The flag overrides the
/// `profile` of `.github/jactionlint.yaml`. Binary via mise
/// `github:jdx/jactionlint`; shellcheck (`aqua:koalaman/shellcheck`) on PATH
/// enables run-script linting.
function jactionlintWith(profile: JactionlintProfile): Config.Step = (Builtins.jactionlint) {
  check = withProfile(Builtins.jactionlint.check as Config.CommandSpec, profile)
  check_diff = withProfile(Builtins.jactionlint.check_diff as Config.CommandSpec, profile)
  fix = withProfile(Builtins.jactionlint.fix as Config.CommandSpec, profile)
}

/// `jactionlintWith` at the `correctness` profile: the checks actionlint makes.
/// The `default` profile adds hardening rules (timeouts, concurrency groups,
/// SHA-pinned actions) whose autofixes would rewrite a consumer's workflows
/// during pre-commit. This stays the default only until the preset moves to
/// `pedantic`: https://github.com/gtbuchanan/tooling/issues/678
jactionlint: Config.Step = jactionlintWith("correctness")

/// File-hygiene builtins with the lockfile-exclude already wired.
fileHygiene: Mapping<String, Config.Step> = new {
  ["check-added-large-files"] = (Builtins.check_added_large_files) { exclude = defaultExclude }
  ["end-of-file-fixer"] = (Builtins.newlines) { exclude = defaultExclude }
  ["fix-byte-order-marker"] = (Builtins.byte_order_marker) { exclude = defaultExclude }
  ["trailing-whitespace"] = (Builtins.trailing_whitespace) { exclude = defaultExclude }
}

// POSIX gitlink (submodule, mode 160000) guard; the cmd.exe variant lives
// inline on the Windows branch below.
local gitlinkGuardPosix = "test -z \"$(git ls-files --stage | grep -E '^160000 ' || true)\""

/// Per-OS gitlink (submodule) guard — no hk builtin exists. Runs
/// unconditionally and fails when the index contains a mode-160000 entry.
forbidSubmodules: Config.Step = new {
  check = new Config.Script {
    windows = "git ls-files -s | findstr /b /c:\"160000 \" >nul && exit /b 1 || exit /b 0"
    linux = gitlinkGuardPosix
    macos = gitlinkGuardPosix
    other = gitlinkGuardPosix
  }
}

/// Validates `.github/renovate.json` (every repo extending the shared
/// Renovate preset has one). renovate-config-validator ships only inside
/// the `renovate` npm package, so add `npm:renovate` to your mise [tools].
/// Preset-authoring repos can target `default.json` by amending the glob:
/// `(Defaults.renovateConfig) { glob = "default.json" }`.
renovateConfig: Config.Step = new {
  glob = ".github/renovate.json"
  check = "renovate-config-validator --strict {{files}}"
}

// Select shell sources by the `shell` content type — extension AND shebang —
// so extensionless scripts (mise tasks, the Termux pnpm shim) match. Clear the
// builtin's `match_any`: its `sh`/`bash` clause over-matches (markdown, JSON,
// YAML get treated as shell), and hk 1.51 rejects `match_any` alongside `types`.

/// shellcheck over shell sources selected by content type.
/// Needs shellcheck on PATH (mise `aqua:koalaman/shellcheck`).
shellcheck: Config.Step = (Builtins.shellcheck) {
  match_any = null
  glob = null
  types = List("shell")
  exclude = defaultExclude
}

/// shfmt over shell sources, selected like `shellcheck`.
/// Needs shfmt on PATH (mise `aqua:mvdan/sh`).
shfmt: Config.Step = (Builtins.shfmt) {
  match_any = null
  glob = null
  types = List("shell")
  exclude = defaultExclude
}

/// shellcheck + shfmt as a spreadable group, for repos that lint shell and
/// want to opt the pair in or out as a unit.
shell: Mapping<String, Config.Step> = new {
  ["shellcheck"] = shellcheck
  ["shfmt"] = shfmt
}

/// The recommended step set — spread `...recommended` into a hook's steps to
/// adopt the whole preset in one line, then add only repo-specific steps (e.g.
/// eslint). Every step is glob/type-gated, so the ones a repo doesn't need are
/// inert (pruned, their tool never resolved): a shell-free repo pays nothing
/// for the shell steps. `renovate-preset` (targeting `default.json`) is
/// intentionally omitted — it's specific to preset-authoring repos.
recommended: Mapping<String, Config.Step> = new {
  ...fileHygiene
  ["jactionlint"] = jactionlint
  ["forbid-submodules"] = forbidSubmodules
  ["renovate-config"] = renovateConfig
  ...shell
}

/// `gtb verify`, with `gtb sync` as its fix, so a commit that drifts from the
/// generated config gets it repaired and re-staged rather than reported.
///
/// The glob is a trigger, not a work list: the command takes no `{{files}}`
/// and reads the whole workspace, because drift is a property of the files as
/// a set. A new package with no tsconfig is drift that no changed file
/// carries. So the glob names what decides the plan: manifests, tool configs,
/// Pkl sources, the `test/`, `e2e/` and `skills/` trees that earn a package
/// its tasks, and `pnpm-lock.yaml`, since upgrading the CLI can change the plan
/// with nothing else moving. Lockfiles therefore stay in, and the step takes no
/// `defaultExclude`. Source files are left out: a first `.ts` file earning a
/// root typecheck task would fire the step on every commit, and CI's own
/// `gtb verify` still catches it. `stage` lists what sync writes, because hk
/// otherwise stages only the files the step was triggered by, and sync
/// creates files no commit contained.
local gtbVerify: Config.Step = new {
  glob = List(
    "**/*.pkl",
    "**/PklProject",
    "**/e2e/**",
    "**/eslint.config.*",
    "**/package.json",
    "**/skills/**",
    "**/test/**",
    "**/tsconfig.*.json",
    "**/tsconfig.json",
    "**/turbo.json",
    "**/vitest.config.*",
    "mise.tasks.toml",
    "mise.toml",
    "pnpm-lock.yaml",
    "pnpm-workspace.yaml",
  )
  stage = List(
    "**/PklProject",
    "**/package.json",
    "**/tsconfig.*.json",
    "**/tsconfig.json",
    "mise.tasks.toml",
    "turbo.json",
  )
  check = "gtb verify"
  fix = "gtb sync"
}

/// The steps backed by `@gtbuchanan/cli`, as a spreadable group, with the
/// caller deciding how the `gtb` command resolves:
///
///     ...Defaults.gtbCliSteps(null)         // on PATH, e.g. mise `npm:@gtbuchanan/cli`
///     ...Defaults.gtbCliSteps("pnpm exec")  // a workspace devDependency
///     ...Defaults.gtbCliSteps("pnpm run")   // a repository vendoring the CLI
///
/// Kept out of `recommended`, where every step must be inert in a repo that
/// doesn't need it: this one fails wherever gtb isn't installed. Needs
/// `@gtbuchanan/cli` 2.0.1 or later in a repo that adopts only this preset,
/// since earlier versions demand build config such a repo doesn't have.
// Named `commandPrefix` rather than `prefix`: inside the amended body, a bare
// `prefix` resolves to the property being assigned, which Pkl rejects as
// circular.
function gtbCliSteps(commandPrefix: String?): Mapping<String, Config.Step> =
  new Mapping<String, Config.Step> {
    ["gtb-verify"] = (gtbVerify) { prefix = commandPrefix }
  }

/// Build the standard `pre-commit` / `check` / `fix` hook trio from a step
/// mapping, eliminating the per-repo hook boilerplate. `pre-commit` runs in fix
/// mode and stashes unstaged changes (`patch-file` — faster than `git` and
/// avoids the `index is locked` errors git stash hits on Windows — so a fixer
/// touching a partially-staged file can't drag unstaged hunks into the commit)
/// and adds the commit-time-only `no-commit-to-branch` guard (it needs a branch
/// name, so it errors on CI's detached HEAD and is irrelevant to `check`/`fix`).
/// `check` and `fix` run the same steps in check and fix mode (no stash — they
/// run over all files, not a partial commit). Consumer:
/// `hooks = Defaults.hooksFor(allSteps)`.
function hooksFor(allSteps: Mapping<String, Config.Step>): Mapping<String, Config.Hook> =
  // Keep the explicit `Mapping<String, Config.Hook>`: pklr, the Pkl evaluator
  // hk embeds, merges into an existing Mapping entry only where it recorded
  // the value type, which neither a bare `new { ... }` nor the return
  // annotation does. Without it, a consumer amending a hook silently loses
  // every preset step. pklr 2.0.5 merges either form, so there's no removal
  // trigger once hk picks it up: https://github.com/jdx/pklr/pull/189
  new Mapping<String, Config.Hook> {
    ["pre-commit"] {
      fix = true
      stash = "patch-file"
      steps {
        ...allSteps
        ["no-commit-to-branch"] = Builtins.no_commit_to_branch
      }
    }
    ["check"] {
      steps { ...allSteps }
    }
    ["fix"] {
      fix = true
      steps { ...allSteps }
    }
  }
