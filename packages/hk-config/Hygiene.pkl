/// The `hk util` file-hygiene fixers, plus the guards hk has no builtin for.
module gtbuchanan.hk.Hygiene

import "Exclude.pkl"
import "HkPackage.pkl"

/// File-hygiene builtins with the lockfile-exclude already wired.
fileHygiene: Mapping<String, HkPackage.Step> = new {
  ["check-added-large-files"] = (HkPackage.builtins.check_added_large_files) { exclude = Exclude.defaultExclude }
  ["end-of-file-fixer"] = (HkPackage.builtins.newlines) { exclude = Exclude.defaultExclude }
  ["fix-byte-order-marker"] = (HkPackage.builtins.byte_order_marker) { exclude = Exclude.defaultExclude }
  ["trailing-whitespace"] = (HkPackage.builtins.trailing_whitespace) { exclude = Exclude.defaultExclude }
}

// POSIX gitlink (submodule, mode 160000) guard; the cmd.exe variant lives
// inline on the Windows branch below.
local gitlinkGuardPosix = "test -z \"$(git ls-files --stage | grep -E '^160000 ' || true)\""

/// Per-OS gitlink (submodule) guard — no hk builtin exists. Runs
/// unconditionally and fails when the index contains a mode-160000 entry.
forbidSubmodules: HkPackage.Step = new {
  check = new HkPackage.Script {
    windows = "git ls-files -s | findstr /b /c:\"160000 \" >nul && exit /b 1 || exit /b 0"
    linux = gitlinkGuardPosix
    macos = gitlinkGuardPosix
    other = gitlinkGuardPosix
  }
}

// Names Windows refuses to create: the reserved device names (bare or with an
// extension), the characters Win32 forbids in a path segment, and a segment
// ending in a space or a dot. Matched against the paths hk passes rather than
// the working tree, so the check never has to create one to test itself.
local illegalWindowsNamePattern =
  #"(^|/)(con|prn|aux|nul|com[1-9]|lpt[1-9])(\.|$)|[<>:"|?*\\]|[ .](/|$)"#

local illegalWindowsNamesPosix = """
  if printf '%s\\n' {{files}} | grep -Eiq '\(illegalWindowsNamePattern)'; then
    echo 'error: path is not representable on Windows' >&2
    printf '%s\\n' {{files}} | grep -Ei '\(illegalWindowsNamePattern)' >&2
    exit 1
  fi
  """

/// Rejects paths Windows cannot represent, so a file added on Linux or macOS
/// can't leave the repository un-checkout-able on Windows. Mirrors pre-commit's
/// `check-illegal-windows-names`, which has no hk builtin.
///
/// A no-op on Windows rather than a cmd.exe translation: Windows refuses to
/// create these names, so one only enters from Linux or macOS, which is where
/// the guard runs, CI included.
illegalWindowsNames: HkPackage.Step = new {
  check = new HkPackage.Script {
    windows = "exit /b 0"
    linux = illegalWindowsNamesPosix
    macos = illegalWindowsNamesPosix
    other = illegalWindowsNamesPosix
  }
}
