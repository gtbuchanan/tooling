amends "package://github.com/jdx/hk/releases/download/v2.14.0/hk@2.14.0#/Config.pkl"

// Shared hk preset (@gtbuchanan/tooling). Self-host imports it by relative
// path because tooling can't `package://`-import its own unpublished
// release — the same own-repo-vs-consumer split as the `./` workflow refs
// documented in AGENTS.md. Consumers import it via the published package URL.
import "../packages/hk-config/Defaults.pkl"
import "../packages/hk-config/Renovate.pkl"
import "../packages/hk-config/Workflows.pkl"

local allSteps = new Mapping<String, Step> {
    ...(Defaults.recommended) {
        // Exemptions live in .github/jactionlint.yaml.
        ["jactionlint"] = Workflows.jactionlintWith("pedantic")
    }

    // `pnpm run`: this repository vendors the CLI, so the root `gtb` script
    // runs it from source.
    ...Defaults.gtbCliSteps("pnpm run")

    // `pnpm exec`: eslint and its shared config are workspace devDependencies.
    ...Defaults.nodeSteps("pnpm exec")

    // Validates the shareable preset itself; the .github/renovate.json
    // validator (renovate-config) comes from recommended.
    ["renovate-preset"] = (Renovate.renovateConfig) { glob = "default.json" }
}

hooks = Defaults.hooksFor(allSteps)
