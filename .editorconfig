# https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
indent_size = 2
indent_style = space
insert_final_newline = true
trim_trailing_whitespace = true

# Matches @stylistic/max-len in @gtbuchanan/eslint-config
[*.{cjs,cts,js,mjs,mts,ts}]
max_line_length = 100

[*.py]
indent_size = 4

# Matches the 72-column hard wrap convention for anything landing in `git log`
[{COMMIT_EDITMSG,MERGE_MSG,TAG_EDITMSG}]
max_line_length = 72

# Machine-generated — mirrors the lockfile exclude on hk's file-hygiene steps
[{mise.lock,pnpm-lock.yaml}]
insert_final_newline = unset
trim_trailing_whitespace = unset
